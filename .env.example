# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Ключи приложения с https://developer.spotify.com/dashboard.
# Необязательно: без них бот работает с выгрузками библиотеки (/import — CSV из Exportify или YourLibrary.json)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Должен в точности совпадать с Redirect URI в настройках приложения Spotify
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Админы (Telegram ID через запятую): всегда имеют доступ, управляют настройками и доступом через /admin
ADMIN_USER_IDS=883905237

# Telegram ID пользователей через запятую, которым доступ открыт всегда (из бота их не убрать).
# Остальным доступ выдаёт админ в /admin. Если не заданы ни админы, ни этот список — ботом может пользоваться кто угодно.
ALLOWED_USER_IDS=

# Где хранить токены Spotify, кэш и временные файлы
DATA_DIR=data

# Сколько треков скачивают /last и /shuffle без числа и максимум для /last N, /shuffle N
LAST_TRACKS_DEFAULT=10
LAST_TRACKS_MAX=50

# Где искать треки, по порядку: soundcloud, youtube (например: soundcloud,youtube)
SEARCH_SOURCES=soundcloud

# Битрейт mp3 по умолчанию, кбит/с (админ может поменять его в /admin)
AUDIO_QUALITY=192

# Сколько треков скачивать одновременно
MAX_CONCURRENT_DOWNLOADS=2

LOG_LEVEL=INFO
